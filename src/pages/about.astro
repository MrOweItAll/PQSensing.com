---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "About the Founder — Jon Peterson · PQSensing";
const description = "Jon Peterson is the founder and inventor behind PQSensing — an architectural engineer with an acoustics emphasis and 20+ years of technical development, drafting, and documentation experience, now building Advanced Supervisory Modules for interferometric systems.";
---

<BaseLayout title={title} description={description}>
<main id="top">
    <section class="about-hero">
      <div class="container about-grid">
        <div>
          <p class="eyebrow">About the founder</p>
          <h1>Jon Peterson</h1>
          <p class="about-role">Founder &amp; Inventor, PQSensing · Architectural Engineer (Acoustics)</p>
          <p class="lede">A multidisciplinary engineer who pairs two decades of drafting, documentation, and acoustics work with self-directed study in optics, interferometry, and DSP — and turns it into the disciplined, buildable validation roadmaps behind PQSensing's Advanced Supervisory Modules.</p>
          <div class="cta-row">
            <a class="button primary" href="Jon_Peterson_Resume.pdf" download>Download résumé (PDF)</a>
            <a class="button ghost" href="mailto:mroweitall@gmail.com?subject=PQSensing%20%E2%80%94%20intro">Get in touch</a>
          </div>
        </div>
        <div>
          <!-- To use a real photo: upload it to assets/jon-peterson.jpg (it will replace the monogram automatically). -->
          <div class="portrait-wrap">
            <img class="portrait-photo" src="assets/jon-peterson.jpg" alt="Portrait of Jon Peterson, founder of PQSensing" style="display:none" onload="this.style.display='block';var f=document.getElementById('portraitFallback');if(f)f.style.display='none';">
            <div class="portrait-fallback" id="portraitFallback"><span>JP</span></div>
          </div>
          <p class="portrait-cap">Hugoton, Kansas</p>
        </div>
      </div>
    </section>

    <section class="section-pad">
      <div class="container">
        <div class="section-head wide">
          <p class="eyebrow">Background</p>
          <h2>Engineering rigor from the bench, the blueprint, and the recording studio.</h2>
        </div>
        <div class="bio-prose">
          <p>Jon is an architectural engineer with an acoustics emphasis and <strong>20+ years</strong> of practical experience producing buildable drawings, construction documents, field measurements, models, and technical plans. That career — across architectural drafting, engineering support, and acoustical consulting — built a habit that now defines PQSensing: take an idea from theory to clear diagrams, defensible test plans, and reproducible analysis.</p>
          <p>Today he leads <strong>PQSensing</strong> as founder, inventor, and independent technical developer, advancing <strong>Noise-Stationary Locking</strong> — the flagship of a family of Advanced Supervisory Modules that hold precision interferometric instruments at their best measurement operating point. He prepares the non-confidential concept diagrams, validation plans, and partner-facing materials, and frames the work around a lean, low-cost tabletop validation sprint.</p>
          <p>His background in <strong>acoustics, signal flow, and DSP</strong> — sharpened over years of home-studio music production — maps naturally onto interferometric measurement, noise, and control, while his drafting discipline keeps the engineering organized, documented, and buildable.</p>
          <div class="music-card">
            <h3>EverSound Records</h3>
            <p>Jon also writes, produces, and releases music through EverSound Records, a home-studio label shaped by the same ear for signal flow, texture, timing, and detail that informs his acoustics and DSP work.</p>
            <div class="music-meta"><span>Latest single</span><span>A Real Charmer</span><span>AI Gentle Remaster</span></div>
            <audio controls preload="metadata">
              <source src="assets/audio/a-real-charmer-ai-gentle-remaster.wav" type="audio/wav">
              Your browser does not support the audio player.
            </audio>
            <div class="music-links">
              <p class="wav-embed-label">Play the catalog right here — pick an album:</p>
              <div class="wav-embed-wrap">
                <iframe
                  id="wavPlayer"
                  class="wav-embed"
                  title="Wavlake player — EverSound Records"
                  src="https://embed.wavlake.com/album/9598fb36-52ba-4827-adf9-de85f487e5f4"
                  loading="lazy"
                  frameborder="0"
                  allow="encrypted-media; clipboard-write; autoplay"
                  referrerpolicy="strict-origin-when-cross-origin"></iframe>
              </div>
              <div class="wav-chips" id="wavChips" role="tablist" aria-label="EverSound Records releases on Wavlake">
                <a class="wav-chip is-active" data-album="9598fb36-52ba-4827-adf9-de85f487e5f4" role="tab" aria-selected="true" href="https://wavlake.com/album/9598fb36-52ba-4827-adf9-de85f487e5f4" target="_blank" rel="noopener">A Real Charmer</a>
                <a class="wav-chip" data-album="2bedc69a-cc32-45b3-b153-5b0f0fe5c595" role="tab" aria-selected="false" href="https://wavlake.com/album/2bedc69a-cc32-45b3-b153-5b0f0fe5c595" target="_blank" rel="noopener">Homemade and Funky</a>
                <a class="wav-chip" data-album="0bb63f08-9d96-47e3-88a6-86f33ad1ace8" role="tab" aria-selected="false" href="https://wavlake.com/album/0bb63f08-9d96-47e3-88a6-86f33ad1ace8" target="_blank" rel="noopener">Lost In The NeverWas</a>
                <a class="wav-chip" data-album="93eb03e4-92c6-48b7-875c-59d3042ecad5" role="tab" aria-selected="false" href="https://wavlake.com/album/93eb03e4-92c6-48b7-875c-59d3042ecad5" target="_blank" rel="noopener">New Sky</a>
                <a class="wav-chip" data-album="eb1a22bf-6419-4354-b335-7970a1f791d2" role="tab" aria-selected="false" href="https://wavlake.com/album/eb1a22bf-6419-4354-b335-7970a1f791d2" target="_blank" rel="noopener">Southbound Train</a>
                <a class="wav-chip" data-album="4343c836-9215-4b11-891d-b6e8f0feccbd" role="tab" aria-selected="false" href="https://wavlake.com/album/4343c836-9215-4b11-891d-b6e8f0feccbd" target="_blank" rel="noopener">Time After Time</a>
                <a class="wav-chip" data-album="e0be09ee-4b3b-4891-bed0-40b8a5207a91" role="tab" aria-selected="false" href="https://wavlake.com/album/e0be09ee-4b3b-4891-bed0-40b8a5207a91" target="_blank" rel="noopener">Oldie Cologne</a>
                <a class="wav-chip" data-album="8da81891-47e5-4ef0-bc64-6869b8748d12" role="tab" aria-selected="false" href="https://wavlake.com/album/8da81891-47e5-4ef0-bc64-6869b8748d12" target="_blank" rel="noopener">Sittin’ On The Dock Of The Bay</a>
                <a class="wav-chip" data-album="e74294f4-ed68-4df8-91c3-5f6ea2bb5ea0" role="tab" aria-selected="false" href="https://wavlake.com/album/e74294f4-ed68-4df8-91c3-5f6ea2bb5ea0" target="_blank" rel="noopener">In The Name Of</a>
              </div>
              <a class="wav-primary" href="https://wavlake.com/jon-peterson" target="_blank" rel="noopener">Open the full catalog on Wavlake →</a>
            </div>
            <script is:inline>
              (function () {
                var frame = document.getElementById('wavPlayer');
                var chips = document.getElementById('wavChips');
                if (!frame || !chips) return;
                chips.addEventListener('click', function (e) {
                  var chip = e.target.closest('.wav-chip');
                  if (!chip) return;
                  // let modifier/middle clicks open the real Wavlake link normally
                  if (e.metaKey || e.ctrlKey || e.shiftKey || e.button === 1) return;
                  var id = chip.getAttribute('data-album');
                  if (!id) return;
                  e.preventDefault();
                  frame.src = 'https://embed.wavlake.com/album/' + id;
                  chips.querySelectorAll('.wav-chip').forEach(function (c) {
                    c.classList.remove('is-active');
                    c.setAttribute('aria-selected', 'false');
                  });
                  chip.classList.add('is-active');
                  chip.setAttribute('aria-selected', 'true');
                });
              })();
            </script>
          </div>
        </div>
      </div>
    </section>

    <section class="section-pad dark-block">
      <div class="container">
        <div class="section-head wide">
          <p class="eyebrow">Experience</p>
          <h2>A through-line of measurement, documentation, and applied engineering.</h2>
        </div>
        <div class="timeline">
          <div class="t-item">
            <div class="t-when">Current</div>
            <div class="t-what"><h3>Founder / Inventor — PQSensing</h3><p>Develops the Noise-Stationary Locking control concept and the supervisory-module platform; produces concept diagrams, validation roadmaps, and partner-facing technical materials, integrating independent study in optics, photonics, interferometry, measurement noise, and DSP.</p><p class="portfolio-note">Read the <a href="/publications.html">technical papers</a> behind the platform.</p></div>
          </div>
          <div class="t-item">
            <div class="t-when">2010 – present</div>
            <div class="t-what"><div class="company-heading"><h3>Contract Architectural Draftsman / CAD Technician — Media+Architecture</h3></div><p>Self-employed drafting for regional architects, builders, and owners: floor plans, elevations, sections, details, schedules, field measurements, and as-builts on projects from roughly $50K to $5M, with AI-assisted workflows for productivity.</p><p class="portfolio-note">Project ownership and original files remain with Dan Fankhauser. See selected work on the <a href="/architecture.html">Media&nbsp;+&nbsp;Architecture</a> page.</p></div>
          </div>
          <div class="t-item">
            <div class="t-when">2000 – 2003</div>
            <div class="t-what"><h3>Acoustical Consulting — Engineering Dynamics International &amp; Acoustical Design Group</h3><p>Acoustical and theatre consulting: acoustical modeling, sound-system CAD drawings, AV equipment evaluation, technical documentation, and client coordination for performance-space and architectural-acoustics projects.</p></div>
          </div>
          <div class="t-item">
            <div class="t-when">1998 – 1999</div>
            <div class="t-what"><h3>HABS Scholarship Team — University of Kansas</h3><p>Documented the New York Life Insurance Building at 20 West Ninth Street in Kansas City for archival submission to the Library of Congress under the Historic American Buildings Survey; credited by LOC as Jon Peterson, delineator, with the measured-drawing set earning honorable mention for the Charles E. Peterson Prize. Jon took field measurements and produced measured pencil/construction drawings for the project, including work later traced in ink for the final HABS sheet set.</p><div class="inline-links"><a href="https://www.loc.gov/item/mo0432/" target="_blank" rel="noopener">LOC HABS record</a><a href="https://www.loc.gov/resource/hhh.mo0432.sheet.00007a/" target="_blank" rel="noopener">LOC Sheet 7</a><a href="https://www.loc.gov/resource/hhh.mo0432.sheet.00010a/" target="_blank" rel="noopener">LOC Sheet 10</a><a href="https://www.loc.gov/resource/hhh.mo0432.sheet.00015a/" target="_blank" rel="noopener">LOC Sheet 15</a></div></div>
          </div>
        </div>
      </div>
    </section>

    <section class="section-pad">
      <div class="container">
        <div class="section-head wide">
          <p class="eyebrow">Education &amp; recognition</p>
          <h2>Credentials.</h2>
        </div>
        <div class="creds">
          <div class="cred"><h3>B.S., Architectural Engineering</h3><p>University of Kansas — Acoustics emphasis. EIT (Engineer in Training) certification.</p></div>
          <div class="cred"><h3>Recognition</h3><p>HABS / Recording &amp; Representing Historic Structures scholarship (’98, ’99); honorable mention, Charles E. Peterson Prize; runner-up, ASA Student Design Competition.</p></div>
          <div class="cred"><h3>Memberships</h3><p>Member of Mensa; affiliations with the Acoustical Society of America (ASA) and ASHRAE.</p></div>
        </div>
        <div class="chips" aria-label="Selected skills">
          <span class="chip">AutoCAD LT</span><span class="chip">SketchUp</span><span class="chip">CAD/CAM</span><span class="chip">Construction documents</span><span class="chip">Acoustical modeling</span><span class="chip">Optical interferometry</span><span class="chip">DSP / control concepts</span><span class="chip">Technical writing</span><span class="chip">AI-assisted workflows</span><span class="chip">Logic Pro production</span>
        </div>
        <div class="cta-row" style="margin-top:34px">
          <a class="button primary" href="Jon_Peterson_Resume.pdf" download>Download full résumé (PDF)</a>
          <a class="button ghost" href="modules.html">Explore the modules</a>
        </div>
      </div>
    </section>
  </main>



<style>
  .music-links { margin-top: 18px; }
  .wav-primary {
    display: inline-block;
    color: var(--cyan, #39dfff);
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
  }
  .wav-primary:hover { text-decoration: underline; }
  .wav-chips {
    margin-top: 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .wav-chip {
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid rgba(96, 219, 255, 0.28);
    background: rgba(255, 255, 255, 0.04);
    color: #cfe3f2;
    font-size: 13px;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .wav-chip:hover {
    border-color: rgba(96, 219, 255, 0.6);
    color: #fff;
    background: rgba(57, 223, 255, 0.1);
  }
  .wav-chip.is-active {
    border-color: var(--teal, #49f4c8);
    color: #02121a;
    background: linear-gradient(135deg, var(--cyan, #39dfff), var(--teal, #49f4c8));
    font-weight: 700;
  }
  .wav-embed-label {
    margin: 4px 0 12px;
    font-size: 14px;
    color: var(--muted, #a7c4d8);
  }
  .wav-embed-wrap {
    position: relative;
    width: 100%;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--line, rgba(96, 219, 255, 0.24));
    background: #04101e;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.35);
  }
  .wav-embed {
    display: block;
    width: 100%;
    height: 480px;
    border: 0;
    background: #04101e;
  }
  .music-links .wav-primary { margin-top: 16px; }
  @media (max-width: 560px) {
    .wav-embed { height: 420px; }
  }

  /* ---- Bio / résumé / music page layout ---- */
  .about-grid { display: grid; grid-template-columns: 1.45fr 0.9fr; gap: 48px; align-items: start; }
  .about-role { color: var(--cyan, #39dfff); font-family: 'IBM Plex Mono', monospace; font-size: 13px; letter-spacing: 0.03em; margin: 0 0 18px; }

  .portrait-wrap {
    position: relative; border-radius: 24px; overflow: hidden;
    border: 1px solid var(--line, rgba(96,219,255,.24));
    box-shadow: var(--shadow); aspect-ratio: 4 / 5;
    background: linear-gradient(160deg, rgba(57,223,255,.14), rgba(154,99,255,.10));
  }
  .portrait-photo { width: 100%; height: 100%; object-fit: cover; display: block; }
  .portrait-fallback { position: absolute; inset: 0; display: grid; place-items: center; }
  .portrait-fallback span { font-family: var(--font-display); font-size: 66px; font-weight: 800; color: #bfe9ff; letter-spacing: 0.04em; }
  .portrait-cap { margin: 12px 0 0; text-align: center; color: var(--muted2, #7aa4bc); font-size: 13px; font-family: 'IBM Plex Mono', monospace; }

  .bio-prose p { color: var(--muted, #a7c4d8); font-size: 17px; line-height: 1.7; margin: 0 0 16px; max-width: 72ch; }
  .bio-prose strong { color: #fff; }

  /* EverSound music card */
  .music-card {
    margin-top: 30px; padding: 28px 26px;
    border: 1px solid var(--line, rgba(96,219,255,.24)); border-radius: 24px;
    background: linear-gradient(160deg, rgba(57,223,255,.06), rgba(255,255,255,.02));
  }
  .music-card h3 { font-size: 20px; margin: 0 0 10px; color: #fff; }
  .music-card > p { color: var(--muted, #a7c4d8); line-height: 1.6; margin: 0 0 14px; font-size: 15px; }
  .music-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0 10px; margin: 0 0 14px; color: var(--muted2, #7aa4bc); font-family: 'IBM Plex Mono', monospace; font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase; }
  .music-meta span:not(:first-child)::before { content: '·'; margin-right: 10px; opacity: 0.55; }
  .music-card audio { width: 100%; margin-bottom: 4px; }

  /* Experience timeline (text only) */
  .timeline { margin-top: 8px; }
  .t-item { display: grid; grid-template-columns: 160px 1fr; gap: 30px; padding: 26px 0; border-top: 1px solid var(--line2, rgba(255,255,255,.1)); }
  .t-item:first-child { border-top: none; padding-top: 6px; }
  .t-when { font-family: 'IBM Plex Mono', monospace; font-size: 13px; color: var(--cyan, #39dfff); padding-top: 4px; }
  .company-heading { display: flex; align-items: center; gap: 12px; }
  .t-what h3 { font-size: 19px; margin: 0 0 8px; color: #fff; line-height: 1.25; }
  .t-what p { color: var(--muted, #a7c4d8); line-height: 1.65; margin: 0 0 12px; font-size: 15px; }
  .portfolio-note { font-size: 13px; color: var(--muted2, #7aa4bc); font-style: italic; }
  .portfolio-note a { color: var(--cyan, #39dfff); font-style: normal; }
  .inline-links { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 10px; }
  .inline-links a { color: var(--cyan, #39dfff); font-size: 13px; font-family: 'IBM Plex Mono', monospace; }

  /* Credentials + skills */
  .creds { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-top: 8px; }
  .cred { border: 1px solid var(--line, rgba(96,219,255,.24)); border-radius: 18px; background: var(--panel2, rgba(255,255,255,.045)); padding: 22px; }
  .cred h3 { font-size: 17px; margin: 0 0 8px; color: #fff; }
  .cred p { color: var(--muted, #a7c4d8); font-size: 14px; line-height: 1.55; margin: 0; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 26px; }
  .chip { border: 1px solid var(--line, rgba(96,219,255,.24)); background: rgba(255,255,255,.04); border-radius: 999px; padding: 6px 13px; color: #cfe3f2; font-size: 13px; }

  @media (max-width: 860px) {
    .about-grid { grid-template-columns: 1fr; }
    .t-item { grid-template-columns: 1fr; gap: 6px; }
    .creds { grid-template-columns: 1fr; }
  }
</style>
</BaseLayout>
