---
import BaseLayout from '../layouts/BaseLayout.astro';
import services from '../data/services.json';
import portfolio from '../data/portfolio.json';

const title = 'Media + Architecture — Precision Drafting, HABS Documentation & Visualization';
const description =
  'Media + Architecture is the spatial-documentation practice of Peterson Quantum Sensing’s founder: architectural drafting, HABS/HAER historic documentation, and photoreal 3D visualization. Productized packages for residential, commercial, and historic projects.';

const packages = services.packages;

// Full portfolio (project-grouped, in-page carousel). Data generated in src/data/portfolio.json.
const totalImages = portfolio.reduce((n, p) => n + p.images.length, 0);

const filters = [
  { key: 'all', label: 'All work' },
  { key: 'viz', label: '3D Visualization' },
  { key: 'plans', label: 'Plans & Drafting' },
  { key: 'habs', label: 'HABS Documentation' },
];

const briefBody =
  'Project type / scope:\n' +
  'Approximate size or building:\n' +
  'Target timeline:\n' +
  'Project location:\n' +
  'Anything else I should know:\n';
const mailto = (subject, body = '') =>
  'mailto:mroweitall@gmail.com?subject=' + encodeURIComponent(subject) +
  (body ? '&body=' + encodeURIComponent(body) : '');

const steps = [
  { n: '1', title: 'Brief', text: 'Send the scope, any existing drawings or site photos, and your timeline. You get a fixed-fee proposal back.' },
  { n: '2', title: 'Draft review', text: 'Work is shared as a draft set for markup. One revision round is included so the drawings match intent before final.' },
  { n: '3', title: 'Final files + ownership', text: 'Coordinated PDF + DWG deliverables handed over — you receive the final files and full ownership of the drawings.' },
];
---

<BaseLayout title={title} description={description} ogImage="/assets/drafting/renderings/2022-17-southwind-house-photoreal-concept.jpg">
  <main id="top" class="arch">
    <section class="arch-hero">
      <div class="arch-hero-grid" aria-hidden="true"></div>
      <div class="container arch-hero-inner">
        <figure class="arch-logo-plate">
          <img class="arch-logo" src="/assets/brand/ma-logo.jpg" width="1099" height="1100" alt="Media + Architecture — m+a monogram over a classical portico" />
        </figure>
        <p class="arch-eyebrow">Peterson Systems · Spatial &amp; Historic Documentation</p>
        <h1>Media&nbsp;+&nbsp;Architecture</h1>
        <p class="arch-lede">
          Precision architectural drafting, HABS/HAER historic documentation, and
          photoreal 3D visualization — the spatial-documentation practice run by the
          founder of Peterson Quantum Sensing. The same discipline that goes into
          interferometer control systems, applied to buildings.
        </p>
        <div class="arch-cta-row">
          <a class="arch-btn primary" href="#packages">View service packages</a>
          <a class="arch-btn ghost" href="#portfolio">See the portfolio</a>
        </div>
        <div class="arch-facts">
          <span><strong>20+ years</strong> drafting &amp; documentation</span>
          <span><strong>NPS-standard</strong> HABS / HAER work</span>
          <span><strong>Photoreal</strong> concept visualization</span>
        </div>
      </div>
    </section>

    <section id="packages" class="arch-section">
      <div class="container">
        <div class="arch-head">
          <p class="arch-eyebrow">Service packages</p>
          <h2>Fixed-scope packages, clear deliverables.</h2>
          <p>Productized services with defined outputs and timelines — request a package and it lands in the inbox pre-labeled, ready to scope.</p>
        </div>
        <div class="pkg-grid">
          {packages.map((p) => (
            <article class:list={['pkg-card', { featured: p.featured }]}>
              {p.featured && <span class="pkg-flag">Most requested</span>}
              <h3>{p.name}</h3>
              <p class="pkg-tagline">{p.tagline}</p>
              <ul class="pkg-list">
                {p.deliverables.map((d) => <li>{d}</li>)}
              </ul>
              <div class="pkg-meta">
                <span class="pkg-timeline">{p.timeline}</span>
                <span class="pkg-price">{p.priceRange ? p.priceRange : 'Pricing on request'}</span>
              </div>
              <a class="arch-btn primary full" href={'/contact.html?type=architecture&package=' + encodeURIComponent(p.name)}>Request this package</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="arch-section">
      <div class="container">
        <div class="arch-head">
          <p class="arch-eyebrow">How it works</p>
          <h2>A simple, low-risk process.</h2>
        </div>
        <div class="steps-grid">
          {steps.map((s) => (
            <article class="step-card">
              <span class="step-n">{s.n}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </article>
          ))}
        </div>
        <div class="trust-strip">
          <span><strong>20+ years</strong> of drafting &amp; documentation experience</span>
          <span><strong>HABS / HAER</strong> measured drawings to NPS standards</span>
          <span><strong>PDF + DWG</strong> deliverables · you own the final files</span>
        </div>
      </div>
    </section>

    <section id="portfolio" class="arch-section alt">
      <div class="container">
        <div class="arch-head">
          <p class="arch-eyebrow">Selected work</p>
          <h2>Portfolio.</h2>
          <p>Residential and commercial drafting, historic documentation, and concept visualization — {portfolio.length} projects, {totalImages} drawings and renders. Click any project to page through the full set in place.</p>
        </div>
        <div class="arch-filters" role="tablist" aria-label="Filter portfolio">
          {filters.map((f, i) => (
            <button
              type="button"
              class:list={['arch-filter', { active: i === 0 }]}
              data-filter={f.key}
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}>{f.label}</button>
          ))}
        </div>
        <div class="arch-gallery">
          {portfolio.map((proj, pi) => (
            <button
              type="button"
              class="arch-tile"
              data-cat={proj.cat}
              data-project={pi}
              aria-label={`${proj.title} — open ${proj.images.length}-image gallery`}>
              <img src={proj.cover} alt={proj.title} loading="lazy" decoding="async" />
              {proj.images.length > 1 && <span class="arch-tile-count">{proj.images.length} images</span>}
              <span class="arch-tile-label">
                <strong>{proj.title}</strong>
                {proj.blurb && <em>{proj.blurb}</em>}
              </span>
            </button>
          ))}
        </div>
      </div>

      <!-- In-page carousel viewer (replaces separate-tab image opening) -->
      <div class="arch-lightbox" id="archLightbox" hidden aria-modal="true" role="dialog" aria-label="Project gallery">
        <div class="arch-lb-top">
          <div>
            <div class="arch-lb-title" id="archLbTitle"></div>
            <div class="arch-lb-count" id="archLbCount"></div>
          </div>
          <button class="arch-lb-btn arch-lb-close" type="button" id="archLbClose" aria-label="Close gallery">&times;</button>
        </div>
        <div class="arch-lb-stage">
          <button class="arch-lb-btn arch-lb-prev" type="button" id="archLbPrev" aria-label="Previous image">&#8249;</button>
          <img id="archLbImage" src="" alt="" />
          <button class="arch-lb-btn arch-lb-next" type="button" id="archLbNext" aria-label="Next image">&#8250;</button>
        </div>
        <div class="arch-lb-caption" id="archLbCaption"></div>
        <div class="arch-lb-actions"><a class="arch-lb-open" id="archLbOpen" href="#" target="_blank" rel="noopener">Open full-size ↗</a></div>
      </div>
    </section>

    <script is:inline define:vars={{ portfolio }}>
      (function () {
        const lb = document.getElementById('archLightbox');
        const img = document.getElementById('archLbImage');
        const titleEl = document.getElementById('archLbTitle');
        const countEl = document.getElementById('archLbCount');
        const capEl = document.getElementById('archLbCaption');
        const openEl = document.getElementById('archLbOpen');
        const btnClose = document.getElementById('archLbClose');
        const btnPrev = document.getElementById('archLbPrev');
        const btnNext = document.getElementById('archLbNext');
        let proj = null, idx = 0, lastFocus = null;

        function render() {
          const item = proj.images[idx];
          if (!item) return;
          img.src = item.full;
          img.alt = (item.caption ? item.caption + ' — ' : '') + proj.title;
          titleEl.textContent = proj.title;
          countEl.textContent = proj.images.length > 1 ? `${idx + 1} / ${proj.images.length}` : '';
          capEl.textContent = item.caption || '';
          openEl.href = item.full;
          const multi = proj.images.length > 1;
          btnPrev.style.display = multi ? '' : 'none';
          btnNext.style.display = multi ? '' : 'none';
        }
        function open(pi, i) {
          proj = portfolio[pi]; idx = i || 0;
          lastFocus = document.activeElement;
          render();
          lb.hidden = false;
          document.body.style.overflow = 'hidden';
          btnClose.focus();
        }
        function close() {
          lb.hidden = true;
          img.removeAttribute('src');
          document.body.style.overflow = '';
          if (lastFocus && lastFocus.focus) lastFocus.focus();
        }
        function step(d) { idx = (idx + d + proj.images.length) % proj.images.length; render(); }

        document.querySelectorAll('.arch-tile').forEach((tile) => {
          tile.addEventListener('click', () => open(parseInt(tile.getAttribute('data-project'), 10), 0));
        });
        btnClose.addEventListener('click', close);
        btnPrev.addEventListener('click', () => step(-1));
        btnNext.addEventListener('click', () => step(1));
        lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
        document.addEventListener('keydown', (e) => {
          if (lb.hidden) return;
          if (e.key === 'Escape') close();
          else if (e.key === 'ArrowLeft') step(-1);
          else if (e.key === 'ArrowRight') step(1);
        });
      })();
    </script>

    <section class="arch-section">
      <div class="container arch-founder">
        <div>
          <p class="arch-eyebrow">One practitioner, two disciplines</p>
          <h2>Why the same person does both.</h2>
          <p>
            Architectural documentation and interferometric metrology reward the same
            habits: exacting measurement, disciplined tolerances, and drawings you can
            build from. Media + Architecture is a separate practice with its own clients
            and deliverables — but it runs on the same standard of precision as the
            quantum-sensing work.
          </p>
          <div class="arch-cta-row">
            <a class="arch-btn primary" href="/contact.html?type=architecture">Start a project</a>
            <a class="arch-btn ghost" href="/index.html">Back to Peterson Quantum Sensing</a>
          </div>
        </div>
        <aside class="arch-quote-card">
          <span class="arch-quote-label">Request a quote</span>
          <p>Have drawings, a site, or a historic structure that needs documenting? Send the scope and timeline and you’ll get a fixed-fee proposal.</p>
          <a class="arch-btn primary full" href="/contact.html?type=architecture">Email a project brief</a>
        </aside>
      </div>
    </section>
  </main>
</BaseLayout>

<script is:inline>
  (function () {
    const filters = document.querySelectorAll('.arch-filter');
    const tiles = document.querySelectorAll('.arch-tile');
    filters.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-filter');
        filters.forEach((b) => {
          const on = b === btn;
          b.classList.toggle('active', on);
          b.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        tiles.forEach((t) => {
          const show = key === 'all' || t.getAttribute('data-cat') === key;
          t.style.display = show ? '' : 'none';
        });
      });
    });
  })();
</script>

<style>
  /* Architectural sub-brand palette: gold/ochre + CAD grid, on the shared dark base. */
  /* Media+Architecture: yellow trace paper, graphite mechanical linework, blueprint-blue accents. */
  .arch {
    --arch-paper: #f4e8a6;      /* canary trace paper */
    --arch-paper-2: #efe097;    /* deeper paper for alt bands */
    --arch-paper-3: #e9dd90;    /* image-tile backing */
    --arch-graphite: #2c2e31;   /* graphite ink (headings/body) */
    --arch-graphite-2: #55585e; /* softer graphite */
    --arch-blue: #17458f;       /* blueprint blue */
    --arch-blue-2: #1d59b8;     /* brighter blueprint */
    --arch-ink: #2c2e31;
    --arch-gold: #17458f;       /* legacy alias -> blueprint */
    --arch-gold-2: #1d59b8;     /* legacy alias -> blueprint */
    --arch-line: rgba(44, 46, 49, 0.28);  /* graphite keyline */
    --arch-panel: rgba(255, 255, 255, 0.52);
    background: var(--arch-paper);
    color: var(--arch-graphite);
  }
  .arch h1,
  .arch h2,
  .arch h3 { color: var(--arch-ink); letter-spacing: -0.01em; }
  .arch-eyebrow {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--arch-gold-2);
    margin: 0 0 14px;
  }

  .arch-hero {
    position: relative;
    padding: clamp(70px, 12vw, 150px) 0 clamp(50px, 8vw, 90px);
    overflow: hidden;
    background:
      radial-gradient(120% 120% at 15% 0%, rgba(23, 69, 143, 0.14), transparent 55%),
      var(--arch-paper);
    border-bottom: 1px solid var(--arch-line);
  }
  .arch-hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(23, 69, 143, 0.09) 1px, transparent 1px),
      linear-gradient(90deg, rgba(23, 69, 143, 0.09) 1px, transparent 1px);
    background-size: 46px 46px;
    mask-image: radial-gradient(120% 90% at 20% 10%, #000 30%, transparent 80%);
    -webkit-mask-image: radial-gradient(120% 90% at 20% 10%, #000 30%, transparent 80%);
  }
  .arch-hero-inner { position: relative; }
  .arch-hero h1 {
    font-size: clamp(42px, 8vw, 84px);
    line-height: 1.02;
    margin: 0 0 22px;
  }
  .arch-lede {
    max-width: 680px;
    font-size: clamp(16px, 2vw, 20px);
    line-height: 1.6;
    color: #4d5157;
    margin: 0 0 30px;
  }
  .arch-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 28px;
    margin-top: 34px;
    font-size: 14px;
    color: #5a5e64;
  }
  .arch-facts strong { color: var(--arch-gold-2); }

  .arch-section { padding: clamp(56px, 9vw, 104px) 0; }
  .arch-section.alt { background: var(--arch-paper-2); border-block: 1px solid rgba(255,255,255,0.05); }
  .arch-head { max-width: 640px; margin-bottom: 40px; }
  .arch-head h2 { font-size: clamp(28px, 4vw, 40px); margin: 0 0 14px; }
  .arch-head p { color: #4d5157; line-height: 1.6; margin: 0; }

  .arch-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 24px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
  }
  .arch-btn.primary {
    background: linear-gradient(135deg, var(--arch-gold), var(--arch-gold-2));
    color: #f7fbff;
    box-shadow: 0 10px 30px rgba(23, 69, 143, 0.25);
  }
  .arch-btn.primary:hover { transform: translateY(-2px); box-shadow: 0 14px 36px rgba(23, 69, 143, 0.34); }
  .arch-btn.ghost {
    border: 1px solid var(--arch-line);
    color: var(--arch-gold-2);
    background: transparent;
  }
  .arch-btn.ghost:hover { background: rgba(23, 69, 143, 0.08); }
  .arch-btn.full { width: 100%; margin-top: 18px; }
  .arch-cta-row { display: flex; flex-wrap: wrap; gap: 14px; }

  .pkg-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
  }
  .pkg-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 26px 24px;
    border: 1px solid rgba(44, 46, 49, 0.18);
    border-radius: 18px;
    background: var(--arch-panel);
  }
  .pkg-card.featured {
    border-color: var(--arch-line);
    background: linear-gradient(180deg, rgba(23, 69, 143, 0.08), rgba(255,255,255,0.4));
  }
  .pkg-flag {
    position: absolute;
    top: -11px;
    left: 24px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #f7fbff;
    background: var(--arch-gold-2);
    padding: 4px 10px;
    border-radius: 999px;
    font-weight: 700;
  }
  .pkg-card h3 { font-size: 19px; margin: 0 0 4px; }
  .pkg-tagline { color: #5a5e64; font-size: 14px; margin: 0 0 16px; }
  .pkg-list { list-style: none; padding: 0; margin: 0 0 18px; flex: 1; }
  .pkg-list li {
    position: relative;
    padding-left: 20px;
    margin-bottom: 9px;
    color: #4d5157;
    font-size: 14px;
    line-height: 1.45;
  }
  .pkg-list li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 8px;
    width: 8px;
    height: 8px;
    border: 1.5px solid var(--arch-gold);
    border-radius: 2px;
  }
  .pkg-meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
    padding-top: 14px;
    border-top: 1px solid rgba(44, 46, 49, 0.18);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13px;
  }
  .pkg-timeline { color: #5a5e64; }
  .pkg-price { color: var(--arch-gold-2); font-weight: 600; }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
  }
  .step-card {
    padding: 26px 24px;
    border: 1px solid rgba(44, 46, 49, 0.18);
    border-radius: 18px;
    background: var(--arch-panel);
  }
  .step-n {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: linear-gradient(135deg, var(--arch-gold), var(--arch-gold-2));
    color: #f7fbff;
    font-family: 'IBM Plex Mono', monospace;
    font-weight: 700;
    font-size: 17px;
    margin-bottom: 16px;
  }
  .step-card h3 { font-size: 18px; margin: 0 0 8px; }
  .step-card p { color: #4d5157; line-height: 1.55; margin: 0; font-size: 14px; }
  .trust-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 30px;
    margin-top: 30px;
    padding-top: 24px;
    border-top: 1px solid var(--arch-line);
    font-size: 14px;
    color: #5a5e64;
  }
  .trust-strip strong { color: var(--arch-gold-2); }

  .arch-filters { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 26px; }
  .arch-filter {
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid rgba(44, 46, 49, 0.22);
    background: transparent;
    color: #5a5e64;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .arch-filter:hover { color: var(--arch-ink); border-color: var(--arch-line); }
  .arch-filter.active {
    color: #f7fbff;
    background: var(--arch-gold-2);
    border-color: var(--arch-gold-2);
  }

  .arch-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 16px;
  }
  .arch-tile {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    margin: 0;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(44, 46, 49, 0.18);
    background: var(--arch-paper-3);
    text-decoration: none;
    aspect-ratio: 4 / 3;
    cursor: pointer;
    font: inherit;
    color: inherit;
  }
  .arch-tile:focus-visible { outline: 2px solid var(--arch-gold-2); outline-offset: 2px; }
  .arch-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .arch-tile:hover img { transform: scale(1.05); }
  .arch-tile-count {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    padding: 4px 9px;
    border-radius: 999px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.03em;
    color: #f7fbff;
    background: var(--arch-gold-2);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
  }
  .arch-tile-label {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 30px 14px 12px;
    text-align: left;
    color: #fff;
    background: linear-gradient(transparent, rgba(4, 10, 18, 0.92));
  }
  .arch-tile-label strong { font-size: 14px; font-weight: 700; line-height: 1.2; }
  .arch-tile-label em {
    font-style: normal;
    font-size: 12px;
    line-height: 1.35;
    color: #5a5e64;
    opacity: 0;
    max-height: 0;
    transition: all 0.22s ease;
  }
  .arch-tile:hover .arch-tile-label em,
  .arch-tile:focus-visible .arch-tile-label em { opacity: 1; max-height: 60px; }

  /* Carousel lightbox */
  .arch-lightbox {
    position: fixed;
    inset: 0;
    z-index: 9998;
    display: flex;
    flex-direction: column;
    background: rgba(9, 24, 54, 0.95);
    backdrop-filter: blur(4px);
    padding: 18px clamp(12px, 4vw, 60px) 24px;
  }
  .arch-lightbox[hidden] { display: none; }
  .arch-lb-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    color: #eef2f7;
  }
  .arch-lb-title { font-size: 17px; font-weight: 700; }
  .arch-lb-count { font-family: 'IBM Plex Mono', monospace; font-size: 12px; color: #8fb8ff; margin-top: 2px; }
  .arch-lb-stage {
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin: 12px 0;
  }
  .arch-lb-stage img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 20px 70px rgba(0, 0, 0, 0.6);
  }
  .arch-lb-btn {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid var(--arch-line);
    background: rgba(80, 130, 210, 0.14);
    color: #8fb8ff;
    font-size: 26px;
    line-height: 1;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .arch-lb-btn:hover { background: rgba(80, 130, 210, 0.28); }
  .arch-lb-close { width: 40px; height: 40px; font-size: 24px; }
