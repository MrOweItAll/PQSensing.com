---
/**
 * NSLDemo — interactive Noise-Stationary Locking exhibit (Astro island).
 *
 * Preserves the original live-SVG plot of P(delta), N_band(delta) and
 * V_norm(delta) with both lock points marked, and adds:
 *   - shareable-state URLs (slider values encoded in the URL hash)
 *   - a client-side CSV bench-trace loader (delta,P,Nband) that re-plots
 *     measured lab data through the exact same UI and marks both setpoints.
 *
 * The math comes from ../lib/nsl-model.js — the same module the Vitest
 * suite exercises — so the widget and its tests can never drift apart.
 */
---

<section id="exhibit" class="section-pad exhibit-section">
  <div class="container">
    <div class="section-head wide">
      <p class="eyebrow">Interactive demonstration</p>
      <h2>Watch the two locks <em>disagree</em>.</h2>
      <p>
        A power lock parks at the fringe extremum. A noise-stationary lock parks
        where the slope of
        <span class="mono">V<sub>norm</sub>(δ) = N<sub>band</sub>(δ) / P(δ)<sup>k</sup></span>
        goes to zero. Whenever real-world noise has structure that isn't
        perfectly aligned with the fringe — which it rarely does — those two
        operating points are not the same. Drag the controls, share a regime, or
        drop in a measured bench trace.
      </p>
    </div>

    <div class="exhibit-panel" aria-label="Interactive demonstration: noise-stationary lock vs power lock">
      <div class="exhibit-plot" id="exhibitPlot" role="img" aria-label="Plot of P, N_band, and V_norm versus detuning"></div>

      <div class="exhibit-readout">
        <div class="readout-block">
          <span class="readout-label">Power lock parks at</span>
          <span class="readout-value" id="readPowerDelta">δ = 0.00</span>
          <span class="readout-sub" id="readPowerVnorm">V<sub>norm</sub> there = —</span>
        </div>
        <div class="readout-block readout-block-accent">
          <span class="readout-label">NSL parks at</span>
          <span class="readout-value" id="readNSLDelta">δ = 0.00</span>
          <span class="readout-sub" id="readNSLVnorm">V<sub>norm</sub> there = —</span>
        </div>
        <div class="readout-block readout-block-gain">
          <span class="readout-label">NSL advantage</span>
          <span class="readout-value" id="readGain">— dB</span>
          <span class="readout-sub">in this regime</span>
        </div>
      </div>

      <div class="exhibit-controls">
        <label class="exhibit-control">
          <span class="control-label">
            Noise alignment offset
            <span class="control-hint">how misaligned the structured noise is from the fringe</span>
          </span>
          <input type="range" min="0" max="100" value="68" id="ctrlOffset" class="exhibit-slider" />
          <output id="outOffset" class="control-out">+0.36π</output>
        </label>

        <label class="exhibit-control">
          <span class="control-label">
            Excess-noise strength
            <span class="control-hint">how much structured noise rides on top of the floor</span>
          </span>
          <input type="range" min="0" max="100" value="78" id="ctrlAmp" class="exhibit-slider" />
          <output id="outAmp" class="control-out">0.78</output>
        </label>

        <label class="exhibit-control">
          <span class="control-label">
            Power-weighting exponent k
            <span class="control-hint">k = 0 unweighted, k = 1 SNR-like, k = 2 photon-shot-limited</span>
          </span>
          <input type="range" min="0" max="200" value="100" id="ctrlK" class="exhibit-slider" />
          <output id="outK" class="control-out">k = 1.00</output>
        </label>
      </div>

      <div class="exhibit-legend">
        <span class="legend-item"><span class="legend-swatch legend-p"></span>P(δ) — optical transmission</span>
        <span class="legend-item"><span class="legend-swatch legend-n"></span>N<sub>band</sub>(δ) — measurement-band noise</span>
        <span class="legend-item"><span class="legend-swatch legend-v"></span>V<sub>norm</sub>(δ) — the NSL objective</span>
      </div>

      <!-- Outreach + validation instruments -->
      <div class="exhibit-tools">
        <div class="exhibit-tool-row">
          <button type="button" class="button ghost small" id="btnShare">Copy shareable link</button>
          <span class="tool-status" id="shareStatus" role="status" aria-live="polite"></span>
        </div>

        <div class="exhibit-dropzone" id="csvDrop" tabindex="0" role="button"
             aria-label="Load a measured bench trace: CSV with delta, P, N_band columns">
          <input type="file" id="csvInput" accept=".csv,text/csv" hidden />
          <span class="dz-title">Load a measured bench trace</span>
          <span class="dz-hint">Drop a CSV with <span class="mono">delta, P, N_band</span> columns — or click to browse. The same UI re-plots your data and marks both setpoints.</span>
        </div>

        <div class="exhibit-mode" id="modeRow" hidden>
          <span class="mode-badge" id="modeBadge">Bench data</span>
          <span class="mode-detail" id="modeDetail"></span>
          <button type="button" class="button ghost small" id="btnReset">Back to model</button>
        </div>
      </div>

      <p class="exhibit-note" id="exhibitNote">
        Pedagogical model, not bench data. Analytic curves illustrate the
        slope-null thesis. The validation sprint replaces these with measured
        curves from a tabletop Mach–Zehnder — or drop a trace above to preview
        the comparison on real data now.
      </p>
    </div>
  </div>
</section>

<script>
  import { P, Nband, Vnorm, linspace, findMin, findMax } from '../lib/nsl-model.js';

  (function () {
    'use strict';
    const plotEl = document.getElementById('exhibitPlot');
    if (!plotEl) return;

    const EPS = 0.01;
    const N = 401;
    const ANALYTIC_RANGE = [-Math.PI, Math.PI];

    // ----- plot geometry -----
    const VB = { w: 800, h: 480, padL: 60, padR: 30, padT: 30, padB: 60 };
    const PX = VB.padL;
    const PW = VB.w - VB.padL - VB.padR;
    const PY = VB.padT;
    const PH = VB.h - VB.padT - VB.padB;

    const C = {
      cyan: '#39dfff', gold: '#e8c27a', teal: '#49f4c8',
      muted: 'rgba(167,196,216,0.55)', line: 'rgba(57,223,255,0.10)',
      inkSub: 'rgba(167,196,216,0.85)',
    };

    // ----- DOM hooks -----
    const ctrlOffset = document.getElementById('ctrlOffset');
    const ctrlAmp = document.getElementById('ctrlAmp');
    const ctrlK = document.getElementById('ctrlK');
    const outOffset = document.getElementById('outOffset');
    const outAmp = document.getElementById('outAmp');
    const outK = document.getElementById('outK');
    const readPowerDelta = document.getElementById('readPowerDelta');
    const readPowerVnorm = document.getElementById('readPowerVnorm');
    const readNSLDelta = document.getElementById('readNSLDelta');
    const readNSLVnorm = document.getElementById('readNSLVnorm');
    const readGain = document.getElementById('readGain');
    const btnShare = document.getElementById('btnShare');
    const shareStatus = document.getElementById('shareStatus');
    const csvDrop = document.getElementById('csvDrop');
    const csvInput = document.getElementById('csvInput');
    const modeRow = document.getElementById('modeRow');
    const modeDetail = document.getElementById('modeDetail');
    const btnReset = document.getElementById('btnReset');

    // ----- runtime state -----
    let domain = ANALYTIC_RANGE.slice();
    let benchData = null; // {xs, ps, ns} when a CSV trace is loaded

    // ----- helpers -----
    function xMap(d) {
      return PX + ((d - domain[0]) / (domain[1] - domain[0])) * PW;
    }
    function fmtDelta(d) {
      if (benchData) return 'δ = ' + d.toFixed(3);
      const piFrac = d / Math.PI;
      if (Math.abs(piFrac) < 0.005) return 'δ = 0';
      const sign = piFrac < 0 ? '−' : '';
      return 'δ = ' + sign + Math.abs(piFrac).toFixed(2) + 'π';
    }
    function fmtV(v) {
      if (!isFinite(v)) return '—';
      if (v < 0.01) return v.toExponential(2);
      return v.toFixed(3);
    }

    function buildScaffold() {
      const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      svg.setAttribute('viewBox', `0 0 ${VB.w} ${VB.h}`);
      svg.setAttribute('preserveAspectRatio', 'xMidYMid meet');

      // X-axis tick labels depend on mode.
      let ticks;
      if (benchData) {
        const lo = domain[0], hi = domain[1], mid = (lo + hi) / 2;
        ticks = [
          { d: lo, t: lo.toFixed(2), anchor: 'start' },
          { d: mid, t: mid.toFixed(2), anchor: 'middle' },
          { d: hi, t: hi.toFixed(2), anchor: 'end' },
        ];
      } else {
        ticks = [
          { d: -Math.PI, t: '−π', anchor: 'start' },
          { d: -Math.PI / 2, t: '−π/2', anchor: 'middle' },
          { d: 0, t: '0', anchor: 'middle' },
          { d: Math.PI / 2, t: 'π/2', anchor: 'middle' },
          { d: Math.PI, t: 'π', anchor: 'end' },
        ];
      }
      const tickText = ticks
        .map((tk) => `<text x="${xMap(tk.d).toFixed(1)}" y="${VB.h - 18}" text-anchor="${tk.anchor}">${tk.t}</text>`)
        .join('');
      const vGrid = ticks
        .map((tk) => `<line x1="${xMap(tk.d).toFixed(1)}" y1="${PY}" x2="${xMap(tk.d).toFixed(1)}" y2="${PY + PH}" ${Math.abs(tk.d) < 1e-9 && !benchData ? '' : 'stroke-dasharray="2 4"'}/>`)
        .join('');

      svg.innerHTML = `
        <defs>
          <linearGradient id="gradP" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="${C.cyan}" stop-opacity="0.18"/>
            <stop offset="100%" stop-color="${C.cyan}" stop-opacity="0"/>
          </linearGradient>
        </defs>
        <g stroke="${C.line}" stroke-width="0.8">
          <line x1="${PX}" y1="${PY}" x2="${PX + PW}" y2="${PY}"/>
          <line x1="${PX}" y1="${PY + PH / 4}" x2="${PX + PW}" y2="${PY + PH / 4}" stroke-dasharray="2 4"/>
          <line x1="${PX}" y1="${PY + PH / 2}" x2="${PX + PW}" y2="${PY + PH / 2}" stroke-dasharray="2 4"/>
          <line x1="${PX}" y1="${PY + 3 * PH / 4}" x2="${PX + PW}" y2="${PY + 3 * PH / 4}" stroke-dasharray="2 4"/>
          <line x1="${PX}" y1="${PY + PH}" x2="${PX + PW}" y2="${PY + PH}"/>
          ${vGrid}
        </g>
        <g font-family="'IBM Plex Mono', monospace" font-size="11" fill="${C.muted}" letter-spacing="0.04em">
          ${tickText}
          <text x="${PX + PW / 2}" y="${VB.h - 4}" text-anchor="middle" font-style="italic">detuning δ</text>
          <text x="20" y="${PY + PH / 2}" text-anchor="middle" transform="rotate(-90 20 ${PY + PH / 2})" font-style="italic">P, N_band shared scale · V_norm scaled separately</text>
        </g>
        <path id="exFillP" fill="url(#gradP)" stroke="none"/>
        <path id="exPathP" fill="none" stroke="${C.cyan}" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" opacity="0.7"/>
        <path id="exPathN" fill="none" stroke="${C.gold}" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" opacity="0.8"/>
        <path id="exPathV" fill="none" stroke="${C.teal}" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
        <line id="exGuidePower" stroke="${C.cyan}" stroke-width="1" stroke-dasharray="3 4" opacity="0.5"/>
        <line id="exGuideNSL" stroke="${C.teal}" stroke-width="1.2" stroke-dasharray="3 4" opacity="0.85"/>
        <g id="exMarkPower">
          <circle r="7" fill="#04101e" stroke="${C.cyan}" stroke-width="1.6"/>
          <circle r="3" fill="${C.cyan}"/>
        </g>
        <g id="exMarkNSL">
          <circle r="9" fill="#04101e" stroke="${C.teal}" stroke-width="2"/>
          <path d="M0,-5L1.4,-1.6L5,-1.6L2.1,0.7L3.2,4.5L0,2.4L-3.2,4.5L-2.1,0.7L-5,-1.6L-1.4,-1.6Z" fill="${C.teal}"/>
        </g>
        <g id="exLabelPower" font-family="'IBM Plex Mono', monospace" font-size="11" letter-spacing="0.06em" fill="${C.cyan}">
          <text x="0" y="-14" text-anchor="middle" font-weight="500">Power lock</text>
        </g>
        <g id="exLabelNSL" font-family="'IBM Plex Mono', monospace" font-size="11" letter-spacing="0.06em" fill="${C.teal}">
          <text x="0" y="-16" text-anchor="middle" font-weight="600">NSL lock</text>
        </g>
        <g id="exGap" opacity="0">
          <line x1="0" y1="0" x2="0" y2="0" stroke="${C.inkSub}" stroke-width="0.8" stroke-dasharray="2 3"/>
          <text font-family="'IBM Plex Mono', monospace" font-size="10" letter-spacing="0.08em" fill="${C.inkSub}" text-anchor="middle" font-style="italic">Δδ</text>
        </g>`;

      plotEl.innerHTML = '';
      plotEl.appendChild(svg);
    }

    // Render from arbitrary sampled arrays (shared by analytic + bench modes).
    function render(xs, ps, ns, vs, k) {
      const pMax = Math.max(...ps, 1e-6);
      const P_FLOOR_DRAW = 0.12 * pMax;

      // P and N_band share one scale — both are dimensionless and directly
      // comparable, so their relative heights carry meaning.
      const pnMax = Math.max(pMax, Math.max(...ns), 1e-6) * 1.08;

      // V_norm gets its own scale, fitted to the samples that are ACTUALLY
      // DRAWN (inside the power floor). Scaling to a percentile of every
      // sample let the undrawn dark-fringe blow-ups — where P^k drives V
      // toward its EPS-clamped maximum — compress the visible curve into the
      // bottom few percent of the panel.
      const vDrawn = vs.filter((v, i) => ps[i] >= P_FLOOR_DRAW && isFinite(v));
      const vLo = vDrawn.length ? Math.min(...vDrawn) : 0;
      const vHi = vDrawn.length ? Math.max(...vDrawn) : 1;
      const vPad = (vHi - vLo) * 0.08 || Math.max(vHi * 0.08, 1e-6);
      const vBot = vLo - vPad;
      const vTop = vHi + vPad;

      const yP = (v) => PY + PH - (v / pnMax) * PH * 0.92;
      const yN = yP;
      const yV = (v) => {
        const c = Math.min(Math.max(v, vBot), vTop);
        return PY + PH - ((c - vBot) / (vTop - vBot)) * PH * 0.92;
      };

      const pathP = xs.map((d, i) => `${i === 0 ? 'M' : 'L'}${xMap(d).toFixed(2)},${yP(ps[i]).toFixed(2)}`).join('');
      const pathN = xs.map((d, i) => `${i === 0 ? 'M' : 'L'}${xMap(d).toFixed(2)},${yN(ns[i]).toFixed(2)}`).join('');

      let pathV = '';
      let inSeg = false;
      for (let i = 0; i < xs.length; i++) {
        if (ps[i] >= P_FLOOR_DRAW && isFinite(vs[i])) {
          pathV += (inSeg ? 'L' : 'M') + xMap(xs[i]).toFixed(2) + ',' + yV(vs[i]).toFixed(2);
          inSeg = true;
        } else {
          inSeg = false;
        }
      }

      const baselineY = PY + PH;
      const fillP = pathP + `L${xMap(domain[1]).toFixed(2)},${baselineY}L${xMap(domain[0]).toFixed(2)},${baselineY}Z`;

      document.getElementById('exFillP').setAttribute('d', fillP);
      document.getElementById('exPathP').setAttribute('d', pathP);
      document.getElementById('exPathN').setAttribute('d', pathN);
      document.getElementById('exPathV').setAttribute('d', pathV);

      const idxPmax = findMax(ps).i;
      const pThresh = 0.18 * pMax;
      const allowed = (i) => ps[i] > pThresh;
      const idxV = findMin(vs, allowed).i;

      const dPower = xs[idxPmax];
      const dNSL = xs[idxV];
      const vAtPower = vs[idxPmax];
      const vAtNSL = vs[idxV];

      const xPower = xMap(dPower);
      const xNSL = xMap(dNSL);
      const yMarkP = yP(ps[idxPmax]);
      const yMarkN = yV(vs[idxV]);

      const setLine = (id, x) => {
        const el = document.getElementById(id);
        el.setAttribute('x1', x); el.setAttribute('x2', x);
        el.setAttribute('y1', PY); el.setAttribute('y2', PY + PH);
      };
      setLine('exGuidePower', xPower);
      setLine('exGuideNSL', xNSL);

      document.getElementById('exMarkPower').setAttribute('transform', `translate(${xPower},${yMarkP})`);
      document.getElementById('exMarkNSL').setAttribute('transform', `translate(${xNSL},${yMarkN})`);
      document.getElementById('exLabelPower').setAttribute('transform', `translate(${xPower},${yMarkP})`);
      document.getElementById('exLabelNSL').setAttribute('transform', `translate(${xNSL},${yMarkN})`);

      const gapEl = document.getElementById('exGap');
      if (Math.abs(dPower - dNSL) > (domain[1] - domain[0]) * 0.008) {
        const gapY = PY + PH - 12;
        const midX = (xPower + xNSL) / 2;
        gapEl.setAttribute('opacity', 0.55);
        gapEl.children[0].setAttribute('x1', xPower);
        gapEl.children[0].setAttribute('x2', xNSL);
        gapEl.children[0].setAttribute('y1', gapY);
        gapEl.children[0].setAttribute('y2', gapY);
        gapEl.children[1].setAttribute('x', midX);
        gapEl.children[1].setAttribute('y', gapY - 5);
      } else {
        gapEl.setAttribute('opacity', 0);
      }

      readPowerDelta.textContent = fmtDelta(dPower);
      readPowerVnorm.innerHTML = 'V<sub>norm</sub> there = ' + fmtV(vAtPower);
      readNSLDelta.textContent = fmtDelta(dNSL);
      readNSLVnorm.innerHTML = 'V<sub>norm</sub> there = ' + fmtV(vAtNSL);

      if (vAtNSL > 0 && isFinite(vAtPower) && isFinite(vAtNSL)) {
        const dB = 10 * Math.log10(vAtPower / vAtNSL);
        readGain.textContent = (dB > 0.05 ? '+' : '') + dB.toFixed(2) + ' dB';
      } else {
        readGain.textContent = '— dB';
      }
    }

    function currentK() {
      return parseFloat(ctrlK.value) / 100;
    }

    function updateAnalytic() {
      const offsetRaw = parseFloat(ctrlOffset.value) / 100;
      const offset = (offsetRaw * 2 - 1) * Math.PI;
      const amp = parseFloat(ctrlAmp.value) / 100;
      const k = currentK();

      const piFrac = offset / Math.PI;
      outOffset.textContent = (piFrac >= 0 ? '+' : '−') + Math.abs(piFrac).toFixed(2) + 'π';
      outAmp.textContent = amp.toFixed(2);
      outK.textContent = 'k = ' + k.toFixed(2);

      const xs = linspace(ANALYTIC_RANGE[0], ANALYTIC_RANGE[1], N);
      const ps = xs.map((d) => P(d));
      const ns = xs.map((d) => Nband(d, offset, amp));
      const vs = xs.map((d) => Vnorm(d, offset, amp, k));
      render(xs, ps, ns, vs, k);
    }

    function updateBench() {
      const k = currentK();
      outK.textContent = 'k = ' + k.toFixed(2);
      const { xs, ps, ns } = benchData;
      const vs = ps.map((p, i) => ns[i] / Math.pow(Math.max(p, EPS), k));
      render(xs, ps, ns, vs, k);
    }

    function update() {
      if (benchData) updateBench();
      else updateAnalytic();
      syncURL();
    }

    // ----- shareable-state URLs -----
    function syncURL() {
      const params = new URLSearchParams();
      params.set('o', ctrlOffset.value);
      params.set('a', ctrlAmp.value);
      params.set('k', ctrlK.value);
      try {
        history.replaceState(null, '', '#' + params.toString());
      } catch (_) { /* ignore in restricted contexts */ }
    }
    function loadStateFromURL() {
      if (!window.location.hash) return;
      const params = new URLSearchParams(window.location.hash.slice(1));
      const clamp = (el, val) => {
        if (val === null || val === '') return;
        const n = parseFloat(val);
        if (!isNaN(n)) el.value = String(Math.min(Math.max(n, +el.min), +el.max));
      };
      clamp(ctrlOffset, params.get('o'));
      clamp(ctrlAmp, params.get('a'));
      clamp(ctrlK, params.get('k'));
    }

    if (btnShare) {
      btnShare.addEventListener('click', async () => {
        syncURL();
        const url = window.location.href;
        try {
          await navigator.clipboard.writeText(url);
          shareStatus.textContent = 'Link copied to clipboard';
        } catch (_) {
          shareStatus.textContent = 'Copy this URL: ' + url;
        }
        setTimeout(() => { shareStatus.textContent = ''; }, 4000);
      });
    }

    // ----- CSV bench-trace loader -----
    function parseBenchCSV(csvText) {
      // Ignore blank lines and '#' metadata/comment headers (PQS-Trace-v1.0).
      const lines = csvText
        .split(/\r?\n/)
        .map((l) => l.trim())
        .filter((l) => l && !l.startsWith('#'));
      if (lines.length < 2) throw new Error('CSV has no data rows.');
      const headers = lines[0].toLowerCase().split(',').map((h) => h.trim());
      const findIdx = (...names) =>
        headers.findIndex((h) => names.some((n) => h === n || h.includes(n)));
      const dIdx = findIdx('delta', 'δ', 'phase', 'd');
      const pIdx = findIdx('power', 'p_norm', 'p');
      const nIdx = findIdx('nband', 'n_band', 'noise_band', 'noise', 'psd', 'n');
      if (dIdx === -1 || pIdx === -1 || nIdx === -1) {
        throw new Error('CSV needs columns for delta, P, and N_band.');
      }
      const rows = [];
      for (let i = 1; i < lines.length; i++) {
        const cols = lines[i].split(',');
        const d = parseFloat(cols[dIdx]);
        const p = parseFloat(cols[pIdx]);
        const n = parseFloat(cols[nIdx]);
        if (!isNaN(d) && !isNaN(p) && !isNaN(n)) rows.push({ d, p, n });
      }
      if (rows.length < 2) throw new Error('Could not parse at least two numeric rows.');
      rows.sort((a, b) => a.d - b.d);
      return {
        xs: rows.map((r) => r.d),
        ps: rows.map((r) => r.p),
        ns: rows.map((r) => r.n),
      };
    }

    function enterBenchMode(data, name) {
      benchData = data;
      domain = [data.xs[0], data.xs[data.xs.length - 1]];
      if (domain[1] - domain[0] < 1e-9) domain[1] = domain[0] + 1;
      modeRow.hidden = false;
      modeDetail.textContent =
        name + ' · ' + data.xs.length + ' points · δ ∈ [' +
        domain[0].toFixed(2) + ', ' + domain[1].toFixed(2) + ']';
      // In bench mode the offset/amp sliders no longer drive the model.
      ctrlOffset.disabled = true;
      ctrlAmp.disabled = true;
      buildScaffold();
      update();
    }

    function exitBenchMode() {
      benchData = null;
      domain = ANALYTIC_RANGE.slice();
      modeRow.hidden = true;
      ctrlOffset.disabled = false;
      ctrlAmp.disabled = false;
      buildScaffold();
      update();
    }

    function handleFile(file) {
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (e) => {
        try {
          const data = parseBenchCSV(String(e.target.result));
          enterBenchMode(data, file.name);
        } catch (err) {
          shareStatus.textContent = 'CSV error: ' + err.message;
          setTimeout(() => { shareStatus.textContent = ''; }, 6000);
        }
      };
      reader.readAsText(file);
    }

    if (csvDrop) {
      csvDrop.addEventListener('click', () => csvInput.click());
      csvDrop.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); csvInput.click(); }
      });
      csvInput.addEventListener('change', (e) => handleFile(e.target.files[0]));
      ['dragover', 'dragenter'].forEach((ev) =>
        csvDrop.addEventListener(ev, (e) => { e.preventDefault(); csvDrop.classList.add('drag'); })
      );
      ['dragleave', 'dragend'].forEach((ev) =>
        csvDrop.addEventListener(ev, () => csvDrop.classList.remove('drag'))
      );
      csvDrop.addEventListener('drop', (e) => {
        e.preventDefault();
        csvDrop.classList.remove('drag');
        handleFile(e.dataTransfer.files[0]);
      });
    }
    if (btnReset) btnReset.addEventListener('click', exitBenchMode);

    // ----- init -----
    [ctrlOffset, ctrlAmp, ctrlK].forEach((el) => {
      el.addEventListener('input', update);
      el.addEventListener('change', update);
    });

    loadStateFromURL();
    buildScaffold();
    update();

    let resizeT;
    window.addEventListener('resize', () => {
      clearTimeout(resizeT);
      resizeT = setTimeout(update, 120);
    });
  })();
</script>

