---
/**
 * PaperRow — one entry in the data-driven publications index.
 * Renders title, version, date, abstract, a PDF link, and a collapsible
 * "cite this" BibTeX snippet generated from the manifest entry.
 */
interface Paper {
  id: string;
  title: string;
  short?: string;
  version: string;
  date: string;
  authors: string[];
  abstract: string;
  pdf: string;
  thumb?: string;
}
const { paper } = Astro.props as { paper: Paper };

const year = paper.date.slice(0, 4);
const dateLabel = new Date(paper.date + 'T00:00:00Z').toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  timeZone: 'UTC',
});

const bibKey = 'peterson' + year + paper.id.replace(/-/g, '');
const bibtex = `@techreport{${bibKey},
  title       = {${paper.title}},
  author      = {${paper.authors.join(' and ')}},
  institution = {Peterson Quantum Sensing, LLC},
  year        = {${year}},
  type        = {White Paper},
  version     = {${paper.version}},
  url         = {https://www.pqsensing.com${paper.pdf}}
}`;
---

<article class="paper-row" id={paper.id}>
  {paper.thumb && (
    <a class="paper-thumb" href={paper.pdf} target="_blank" rel="noopener">
      <img src={paper.thumb} alt={`Cover preview: ${paper.title}`} loading="lazy" />
    </a>
  )}
  <div class="paper-body">
    <div class="paper-meta">
      <span class="paper-version">{paper.version}</span>
      <span class="paper-date">{dateLabel}</span>
    </div>
    <h3 class="paper-title">{paper.title}</h3>
    <p class="paper-authors">{paper.authors.join(', ')} · Peterson Quantum Sensing, LLC</p>
    <p class="paper-abstract">{paper.abstract}</p>
    <div class="paper-actions">
      <a class="button primary small" href={paper.pdf} target="_blank" rel="noopener" download>Download PDF</a>
      <details class="cite">
        <summary>Cite this ▾</summary>
        <div class="cite-body">
          <button type="button" class="copy-bib" aria-label={`Copy BibTeX citation for ${paper.title}`}>Copy BibTeX</button>
          <pre class="bibtex"><code>{bibtex}</code></pre>
        </div>
      </details>
    </div>
  </div>
</article>

<style>
  .paper-row {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 26px;
    padding: 28px 0;
    border-top: 1px solid var(--line, rgba(96, 219, 255, 0.24));
  }
  .paper-thumb img {
    width: 100%;
    border-radius: 10px;
    border: 1px solid var(--line2, rgba(255, 255, 255, 0.1));
    background: var(--panel2, rgba(255, 255, 255, 0.045));
    display: block;
  }
  .paper-meta {
    display: flex;
    gap: 12px;
    align-items: center;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted2, #7aa4bc);
    margin-bottom: 8px;
  }
  .paper-version {
    color: #04101e;
    background: var(--cyan, #39dfff);
    padding: 2px 9px;
    border-radius: 999px;
    font-weight: 600;
  }
  .paper-title {
    margin: 0 0 4px;
    font-size: 21px;
    line-height: 1.25;
    color: var(--ink, #eef9ff);
  }
  .paper-authors {
    margin: 0 0 12px;
    font-size: 13px;
    color: var(--muted2, #7aa4bc);
  }
  .paper-abstract {
    margin: 0 0 18px;
    color: var(--muted, #a7c4d8);
    line-height: 1.6;
  }
  .paper-actions {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }
  .button.small {
    padding: 8px 16px;
    font-size: 13px;
  }
  .cite summary {
    cursor: pointer;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13px;
    color: var(--cyan, #39dfff);
    list-style: none;
  }
  .cite summary::-webkit-details-marker {
    display: none;
  }
  .cite-body { position: relative; }
  .copy-bib {
    position: absolute;
    top: 20px;
    right: 10px;
    z-index: 2;
    padding: 5px 11px;
    border-radius: 8px;
    border: 1px solid var(--line, rgba(96, 219, 255, 0.3));
    background: rgba(4, 16, 30, 0.9);
    color: var(--cyan, #39dfff);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11.5px;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .copy-bib:hover { background: rgba(57, 223, 255, 0.14); }
  .bibtex {
    margin: 12px 0 0;
    padding: 16px;
    border-radius: 10px;
    background: rgba(4, 16, 30, 0.75);
    border: 1px solid var(--line, rgba(96, 219, 255, 0.24));
    overflow-x: auto;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--muted, #a7c4d8);
    white-space: pre;
  }
  @media (max-width: 640px) {
    .paper-row {
      grid-template-columns: 1fr;
    }
    .paper-thumb {
      max-width: 160px;
    }
  }
</style>

<script>
  // Delegated once (Astro bundles this component script a single time):
  // copy the sibling BibTeX block to the clipboard.
  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest('.copy-bib');
    if (!btn) return;
    const pre = btn.parentElement?.querySelector('pre.bibtex') as HTMLElement | null;
    if (!pre) return;
    const text = pre.innerText;
    const done = () => {
      const prev = btn.textContent;
      btn.textContent = 'Copied ✓';
      setTimeout(() => { btn.textContent = prev; }, 1600);
    };
    try {
      await navigator.clipboard.writeText(text);
      done();
    } catch {
      const range = document.createRange();
      range.selectNodeContents(pre);
      const sel = getSelection();
      sel?.removeAllRanges();
      sel?.addRange(range);
      done();
    }
  });
</script>
