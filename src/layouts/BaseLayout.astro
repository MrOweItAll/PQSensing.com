---
/**
 * BaseLayout — the unified shell for the standard PQSensing pages
 * (index, modules, about, publications). Injects SEO meta, Open Graph /
 * Twitter cards, canonical URL, and JSON-LD structured data, then wraps
 * the shared Header + Footer around the page slot.
 *
 * Pass `type="article"` + `articleData` to emit TechArticle schema
 * (used for the white-paper / publication pages); otherwise it emits the
 * Organization schema.
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface ArticleData {
  headline: string;
  datePublished: string;
  dateModified?: string;
  abstract: string;
}

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  type?: 'website' | 'article';
  articleData?: ArticleData;
}

const {
  title,
  description,
  ogImage = '/assets/hero.jpg',
  type = 'website',
  articleData,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site).href;

const schemaData =
  type === 'article' && articleData
    ? {
        '@context': 'https://schema.org',
        '@type': 'TechArticle',
        headline: articleData.headline,
        description: articleData.abstract,
        datePublished: articleData.datePublished,
        dateModified: articleData.dateModified || articleData.datePublished,
        mainEntityOfPage: canonicalURL.href,
        author: { '@type': 'Organization', name: 'Peterson Quantum Sensing, LLC' },
        publisher: {
          '@type': 'Organization',
          name: 'Peterson Quantum Sensing, LLC',
          logo: {
            '@type': 'ImageObject',
            url: new URL('/assets/hero.jpg', Astro.site).href,
          },
        },
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'Peterson Quantum Sensing, LLC',
        alternateName: 'PQSensing',
        url: Astro.site?.href,
        logo: new URL('/assets/hero.jpg', Astro.site).href,
        description:
          'Advanced Supervisory Modules for interferometric systems. Flagship module: Noise-Stationary Locking.',
        founder: { '@type': 'Person', name: 'Jon Peterson' },
        email: 'mroweitall@gmail.com',
        telephone: '+1-620-518-3686',
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Hugoton',
          addressRegion: 'KS',
          addressCountry: 'US',
        },
        knowsAbout: [
          'Quantum Sensing',
          'Atomic Interferometry',
          'Phase Noise Mitigation',
          'Precision Metrology',
          'Noise-Stationary Locking',
          'Dark-Port Injection',
        ],
      };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Peterson Quantum Sensing" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
    <slot name="head" />
  </head>
  <body>
    <Header path={Astro.url.pathname} />
    <slot />
    <Footer />

    <script is:inline>
      /* Easter egg: the Konami code opens the "dark port" — a two-source
         interference pattern. Respects prefers-reduced-motion. Pure fun. */
      (function () {
        const seq = ['ArrowUp','ArrowUp','ArrowDown','ArrowDown','ArrowLeft','ArrowRight','ArrowLeft','ArrowRight','b','a'];
        let i = 0;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.addEventListener('keydown', (e) => {
          const k = e.key.length === 1 ? e.key.toLowerCase() : e.key;
          i = k === seq[i] ? i + 1 : (k === seq[0] ? 1 : 0);
          if (i === seq.length) { i = 0; darkPort(); }
        });
        function darkPort() {
          if (document.getElementById('eggPort')) return;
          const wrap = document.createElement('div');
          wrap.id = 'eggPort';
          wrap.setAttribute('role', 'dialog');
          wrap.setAttribute('aria-label', 'Dark port interference easter egg');
          wrap.style.cssText = 'position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;background:rgba(2,8,16,.92);cursor:pointer;opacity:0;transition:opacity .4s ease';
          const cv = document.createElement('canvas');
          const W = Math.min(window.innerWidth, 900), H = Math.min(window.innerHeight, 560);
          cv.width = W; cv.height = H;
          cv.style.cssText = 'max-width:92vw;max-height:70vh;border:1px solid rgba(57,223,255,.3);border-radius:14px;box-shadow:0 30px 90px rgba(0,0,0,.6)';
          const cap = document.createElement('div');
          cap.textContent = '✦ dark port unlocked — two-source interference. (click to close)';
          cap.style.cssText = "position:fixed;bottom:8%;left:0;right:0;text-align:center;color:#49f4c8;font-family:'IBM Plex Mono',monospace;font-size:13px;letter-spacing:.06em";
          wrap.appendChild(cv); wrap.appendChild(cap);
          document.body.appendChild(wrap);
          requestAnimationFrame(() => { wrap.style.opacity = '1'; });
          const ctx = cv.getContext('2d');
          const s1 = { x: W * 0.38, y: H * 0.5 }, s2 = { x: W * 0.62, y: H * 0.5 };
          const img = ctx.createImageData(W, H);
          function draw(t) {
            const k = 0.06, phase = t * 0.06;
            const d = img.data;
            for (let y = 0; y < H; y += 2) {
              for (let x = 0; x < W; x += 2) {
                const r1 = Math.hypot(x - s1.x, y - s1.y), r2 = Math.hypot(x - s2.x, y - s2.y);
                const v = Math.cos(k * r1 - phase) + Math.cos(k * r2 - phase); // -2..2
                const a = (v + 2) / 4;
                const R = 20 + a * 60, G = 120 + a * 135, B = 160 + a * 95;
                for (let dy = 0; dy < 2; dy++) for (let dx = 0; dx < 2; dx++) {
                  const idx = ((y + dy) * W + (x + dx)) * 4;
                  d[idx] = R; d[idx+1] = G; d[idx+2] = B; d[idx+3] = 255;
                }
              }
            }
            ctx.putImageData(img, 0, 0);
          }
          let raf, start = null, animating = !reduce;
          function loop(ts) {
            if (start === null) start = ts;
            draw((ts - start) / 16);
            if ((ts - start) < 9000 && animating) raf = requestAnimationFrame(loop);
          }
          if (reduce) draw(0); else raf = requestAnimationFrame(loop);
          function close() { animating = false; cancelAnimationFrame(raf); wrap.style.opacity = '0'; setTimeout(() => wrap.remove(), 400); }
          wrap.addEventListener('click', close);
          window.addEventListener('keydown', function esc(e){ if(e.key==='Escape'){ close(); window.removeEventListener('keydown', esc);} });
        }
      })();
    </script>
  </body>
</html>
