{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PQS website change request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "description",
    "intent",
    "mustPreserve",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "requestId": {
      "type": "string",
      "pattern": "^PQS-WEB-[0-9]{8}-[0-9]{3,}$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "intent": {
      "enum": [
        "preview",
        "prepare-for-publication"
      ]
    },
    "suggestedSourcePaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "mustPreserve": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "source",
          "status"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "provided",
              "needs-verification",
              "owner-approved"
            ]
          }
        }
      }
    },
    "ownerReviewRequired": {
      "const": true
    }
  },
  "$comment": "This request never constitutes deployment authorization. Publication requires a separately authenticated approval bound to the actual immutable release ID and digest. Suggested paths are not filesystem permissions."
}
